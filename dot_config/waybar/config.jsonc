{
    "output": "DP-4",
    "layer": "top",
    "position": "right",
    "exclusive": true,
    "width": 76,
    "spacing": 8,
    "modules-left": [
        "custom/power",
        "bluetooth",
        "custom/notification",
        "wireplumber"
    ],
    "modules-center": [],
    "modules-right": [
        "custom/apps",
        "custom/clock"
    ],
    "custom/power": {
        "format": "",
        "tooltip-format": "Ausschalten / Abmelden",
        "on-click": "/home/florian/.config/waybar/panel.py power",
        "align": 0.5,
        "justify": "center",
        "icon-spacing": 0
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "",
        "format-off": "",
        "format-connected": "",
        "tooltip-format": "Bluetooth: {status}\nGeräteübersicht öffnen",
        "tooltip-format-connected": "Bluetooth: {num_connections} verbunden\n{device_enumerate}",
        "on-click": "/home/florian/.config/waybar/panel.py bluetooth",
        "align": 0.5,
        "justify": "center"
    },
    "custom/notification": {
        "format": "{icon}",
        "format-icons": {
            "notification": "",
            "none": "",
            "dnd-notification": "",
            "dnd-none": "",
            "inhibited-notification": "",
            "inhibited-none": "",
            "dnd-inhibited-notification": "",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec": "swaync-client --subscribe-waybar",
        "restart-interval": 5,
        "on-click": "swaync-client --toggle-panel --skip-wait",
        "on-click-right": "swaync-client --toggle-dnd --skip-wait",
        "escape": true,
        "align": 0.5,
        "justify": "center",
        "icon-spacing": 0
    },
    "wireplumber": {
        "format": "",
        "format-muted": "",
        "scroll-step": 2,
        "max-volume": 100,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip-format": "Lautstärke: {volume}%\nKlick: Sound-Einstellungen\nScrollen: Lautstärke · Rechtsklick: stumm",
        "align": 0.5,
        "justify": "center"
    },
    "custom/apps": {
        "exec": "/home/florian/.config/waybar/panel.py apps-status",
        "return-type": "json",
        "interval": 10,
        "on-click": "/home/florian/.config/waybar/panel.py apps",
        "align": 0.5,
        "justify": "center",
        "icon-spacing": 0
    },
    "custom/clock": {
        "exec": "/home/florian/.config/waybar/panel.py clock",
        "return-type": "json",
        "interval": 1,
        "on-click": "/home/florian/.config/waybar/panel.py calendar",
        "align": 0.5,
        "justify": "center",
        "icon-spacing": 0
    }
}
